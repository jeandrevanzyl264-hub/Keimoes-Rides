# Safe LOCAL TEST configuration. Copy this whole file to .env.local.
# These accounts and email links belong to demo-keimoes-rides, not production.
VITE_USE_EMULATORS=true

# Keep optional addresses empty for normal local setup and the default live build.
# Local emulators use loopback automatically on the development computer.
VITE_EMULATOR_HOST=
# Optional published HTTPS address for the app's open/share link.
VITE_PUBLIC_APP_URL=
# Optional HTTPS email return origin, only after it is authorised in Firebase.
# Empty preserves Firebase's default hosted email action flow. A Netlify return
# URL is NOT injected automatically.
VITE_AUTH_CONTINUE_URL=

# Publish with: npm run build:production
# That command forces the real Firebase project even when this file says true.
# It preserves src/firebase-config.json and src/map-config.json exactly.
# All VITE_ values are public browser configuration. Never put credentials here.
